---
import { address, addressLines, areas, hours, registeredOffice, services, site } from '../data/business';
import { path } from '../lib/paths';
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="wrap foot-grid">
    <div>
      <a class="logo" href={path('/')} style="margin-bottom:0.8rem">
        <svg viewBox="0 0 32 32" aria-hidden="true" width="38" height="38">
          <rect width="32" height="32" rx="8" fill="#e10600"></rect>
          <path fill="#fff" d="M18.2 3.2 10.4 17.2h5.2L12.6 28.8 23.2 13.4h-5.6L18.2 3.2z"></path>
        </svg>
        <span><strong>Hurley</strong><small>Electrical</small></span>
      </a>
      <address>
        {address.street}<br />
        {address.estate}<br />
        {address.locality}, {address.town}<br />
        {address.postcode}
      </address>
      <p>
        <a href={`tel:${site.phoneTel}`}>{site.phoneDisplay}</a><br />
        <a href={`mailto:${site.email}`}>{site.email}</a>
      </p>
    </div>
    <div>
      <h2>Services</h2>
      <ul>
        {services.map((service) => (
          <li><a href={path(`/services/${service.slug}`)}>{service.title}</a></li>
        ))}
        <li><a href={path('/projects')}>Projects</a></li>
        <li><a href={path('/reviews')}>Reviews</a></li>
      </ul>
    </div>
    <div>
      <h2>Areas</h2>
      <ul>
        {areas.map((area) => (
          <li><a href={path(`/areas/${area.slug}`)}>{area.name}</a></li>
        ))}
      </ul>
    </div>
    <div>
      <h2>Hours on Google</h2>
      <ul>
        {hours.map((day) => (
          <li>{day}: open 24 hours</li>
        ))}
      </ul>
    </div>
  </div>
  <div class="wrap legal">
    <span>{site.legalName}. Company number {site.companyNumber}.</span>
    <span>Registered office: {registeredOffice.oneLine}.</span>
    <span>Workshop: {addressLines()}.</span>
    <a href={path('/privacy')}>Privacy</a>
    <a href={path('/cookies')}>Cookies</a>
    <a href={site.companiesHouse}>Companies House</a>
    <a href={site.googleMaps}>Google listing</a>
    <span>© {year} {site.name}</span>
  </div>
</footer>
