---
import { path as toPath } from '../lib/paths';

interface Crumb { name: string; path: string }
interface Props {
  eyebrow?: string;
  title: string;
  lede: string;
  crumbs: Crumb[];
}
const { eyebrow, title, lede, crumbs } = Astro.props;
---

<section class="page-hero">
  <div class="wrap">
    <nav class="crumbs" aria-label="Breadcrumb">
      {crumbs.map((crumb, i) => (
        <>
          {i > 0 && <span aria-hidden="true">/</span>}
          {i < crumbs.length - 1 ? <a href={toPath(crumb.path)}>{crumb.name}</a> : <span>{crumb.name}</span>}
        </>
      ))}
    </nav>
    {eyebrow && <p class="eyebrow">{eyebrow}</p>}
    <h1>{title}</h1>
    <p class="lede" style="max-width:40rem;color:rgba(255,255,255,.86)">{lede}</p>
  </div>
</section>
