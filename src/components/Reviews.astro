---
import type { Review } from '../data/business';
interface Props { items: Review[] }
const { items } = Astro.props;
const stars = (n: number) => '★★★★★'.slice(0, n) + '☆☆☆☆☆'.slice(0, 5 - n);
---

<div class="review-grid">
  {items.map((review) => (
    <article class="review">
      <header>
        <h3>{review.name}</h3>
        {review.stars !== null && (
          <span class="stars" aria-label={`${review.stars} out of 5 stars`}>{stars(review.stars)}</span>
        )}
      </header>
      <p class="when">{review.date}</p>
      {review.text.split('\n').filter(Boolean).map((line) => <p>{line}</p>)}
      <p class="note">{review.note}</p>
    </article>
  ))}
</div>
