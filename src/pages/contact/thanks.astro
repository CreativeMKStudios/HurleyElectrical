---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import { site } from '../../data/business';

const title = 'Message sent';
const description = 'Your note to Hurley Electrical has been sent. If you need a faster answer, call 01234 857772.';
const crumbs = [
  { name: 'Home', path: '/' },
  { name: 'Contact', path: '/contact' },
  { name: 'Sent', path: '/contact/thanks' },
];
---

<Base title={title} description={description} path="/contact/thanks" crumbs={crumbs} noindex>
  <PageHero
    title="We have your note"
    lede="If the message went through, it is on its way to info@hurleyltd.co.uk. The first time, that inbox may need to confirm the form service."
    crumbs={crumbs}
  />
  <section class="section">
    <div class="wrap prose prose-card" style="max-width:720px">
      <p>If the job is urgent, do not wait on the form. Call <a href={`tel:${site.phoneTel}`}>{site.phoneDisplay}</a>.</p>
      <p><a class="btn btn-navy" href="/">Back to the home page <span class="arrow" aria-hidden="true">→</span></a></p>
    </div>
  </section>
</Base>
