---
import Base from '../layouts/Base.astro';
import { site } from '../data/business';
import { path } from '../lib/paths';

const title = 'Page not found';
const description = 'That page is not on the Hurley Electrical site. Try the home page, services, or call 01234 857772.';
---

<Base title={title} description={description} path="/404" noindex>
  <section class="page-hero">
    <div class="wrap">
      <p class="eyebrow">404</p>
      <h1>That page is not here</h1>
      <p class="lede" style="color:rgba(255,255,255,.86)">The link may be old. The pages below are the ones that exist.</p>
      <div class="hero-actions" style="margin-top:1rem">
        <a class="btn" href={path('/')}>Home <span class="arrow" aria-hidden="true">→</span></a>
        <a class="btn btn-ghost" href={path('/contact')}>Contact</a>
        <a class="btn btn-ghost" href={`tel:${site.phoneTel}`}>{site.phoneDisplay}</a>
      </div>
    </div>
  </section>
  <section class="section">
    <div class="wrap area-grid">
      <a class="area-card" href={path('/services')} style="text-decoration:none"><h2>Services</h2><p>Installation, emergency lighting, and repairs.</p></a>
      <a class="area-card" href={path('/areas')} style="text-decoration:none"><h2>Areas</h2><p>Kempston, Bedford, and the nearby villages.</p></a>
      <a class="area-card" href={path('/reviews')} style="text-decoration:none"><h2>Reviews</h2><p>The Google score is 3.5 from 15 ratings.</p></a>
    </div>
  </section>
</Base>
